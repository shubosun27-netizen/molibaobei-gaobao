# 获取sign
获取当前页面的查询参数部分（即 ? 后面的部分）
const queryString = window.location.search;

# 去掉开头的问号
const queryParamsString = queryString.substring(1);

# 将查询参数转换为对象
const queryParams = {};
queryParamsString.split('&').forEach(param => {
    const [key, value] = param.split('=');
    queryParams[key] = decodeURIComponent(value || ''); // 解码 URL 编码的值
});

# 输出结果
console.log(queryParams, setSign(queryParams));



