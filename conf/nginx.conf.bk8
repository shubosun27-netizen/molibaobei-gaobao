        }

        
        location /106u {
            proxy_pass http://www.106u.com/;
            proxy_redirect off;  # 禁止 302 跳转
        }


        # 添加 moli.u2ip.com:89 的代理配置，修改 Origin 和 Referer
        location /moli {
            # 代理到目标服务器
            proxy_pass http://moli.u2ip.com:89/;
            
            # 修改请求头
            proxy_set_header Host moli.u2ip.com:89;
            proxy_set_header Origin "http://moli.u2ip.com:89";
            proxy_set_header Referer "http://moli.u2ip.com:89/game_moli_gaobao/start/indexQV.html?yofisdk=1&sdkshell=0&channelid=13000&sdkid=0&centerflag=mlbb_newfg";
            
            # 其他常用头设置
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            
            # 禁止重定向
            proxy_redirect off;
            
            # 允许跨域（如果需要）
            add_header Access-Control-Allow-Origin *;
            add_header Access-Control-Allow-Methods 'GET, POST, OPTIONS';
            add_header Access-Control-Allow-Headers 'DNT,X-Mx-ReqToken,Keep-Alive,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Authorization';
            
            # 处理 OPTIONS 预检请求
            if ($request_method = 'OPTIONS') {
                return 204;
            }
        }



        # ########## 核心配置：指定路径返回JSON ##########
        location /api/demo { # 自定义访问路径
            default_type application/json; # 声明响应为JSON类型
            # 返回JSON数据（双引号需转义为\"）
            proxy_pass http://localhost:5000/v1/3rd/api/demo;
        }

        location /servers.json {
            proxy_pass http://localhost:59977;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }




        #error_page  404              /404.html;

        # redirect server error pages to the static page /50x.html
        #
        error_page   500 502 503 504  /50x.html;
        location = /50x.html {
            root   html;
        }
    }

