
#user  nobody;
worker_processes  1;

#error_log  logs/error.log;
#error_log  logs/error.log  notice;
#error_log  logs/error.log  info;

#pid        logs/nginx.pid;


events {
    worker_connections  1024;
}


http {
    include       mime.types;
    default_type  application/octet-stream;

    log_format  main  '$remote_addr - $remote_user [$time_local] "$request" '
                     '$status $body_bytes_sent "$http_referer" '
                     '"$http_user_agent" "$http_x_forwarded_for"';

    log_format custom '$http_referer';

    # log_format  simple  '$remote_addr [$time_local] "$request" $status $body_bytes_sent';
    # access_log  logs/access.log  simple;  # 使用精简格式

    # access_log  logs/access.log  main;

    sendfile        on;
    #tcp_nopush     on;

    #keepalive_timeout  0;
    keepalive_timeout  65;

    gzip  on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml application/octet-stream;
    gzip_min_length 1k;  # 小于 1k 的文件不压缩（避免浪费 CPU）
    gzip_comp_level 6;  # 压缩级别（1-9，6 性价比最高）
    gzip_vary on;  # 告诉浏览器是否支持压缩
    gzip_proxied any;  # 对代理请求也压缩（核心：压缩第三方后端的响应）

    # 2. Brotli 压缩（可选，比 Gzip 压缩率更高，需 Nginx 支持）
    # brotli on;
    # brotli_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;
    # brotli_min_length 1k;
    # brotli_comp_level 6;
    # brotli_vary on;

    server {
        listen       80;
        server_name  localhost;

        location / {
            root   html_myGame;
            index  index.html index.htm;
        }

         # 添加login转发
        location /v1/3rd/api {
            proxy_pass http://localhost:5000;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /servers.json {
            proxy_pass http://localhost:59977;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /v2/3rd/api {
            proxy_pass http://localhost:3000;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/v1 {
            proxy_pass http://localhost:59976;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /xhs/service {
            default_type application/json;
            return 200 '{"code":"200","msg":"success","content":{"records":[{"name":"张三","ss":1,"depart_id":"信息中心","rylx":"","task_inthebase_instate":{},"task_outofbase_approval":{},"working":"1","businesstrip_xian_abovethreedays":{},"businesstrip_xian_lessthanthreedays":{},"businesstrip_luoyang_instate":{},"businesstrip_nonlocal":{},"vacation_xian_abovethreedays":{},"vacation_xian_lessthanthreedays":{},"vacation_nonlocal":{},"study_xian":{},"study_nonlocal":{},"go_abroad":{},"recuperate":{},"departure_date":{},"end_date":{},"address_area_name":{},"remarks":{},"test":"1","attention":{}}],"pages":1}}';
        }

        location /xhs/docs {
            default_type application/json;
            return 200 '{"code":"200","msg":"success","content":{"columnList":[{"columnName":"name","columnType":"varchar","length":4000,"comment":"姓名"},{"columnName":"ss","columnType":"varchar","length":4000,"comment":"所属"},{"columnName":"bm","columnType":"varchar","length":100,"comment":"部门"},{"columnName":"rylx","columnType":"varchar","length":10,"comment":"人员类型"},{"columnName":"task_inthebase_instate","columnType":"int4","length":10,"comment":"任务_内调驻在"},{"columnName":"task_outofbase_approval","columnType":"varchar","length":4000,"comment":"任务_外调"},{"columnName":"working","columnType":"int4","length":10,"comment":"上班"},{"columnName":"businesstrip_xian_abovethreedays","columnType":"int4","length":10,"comment":"出差-西安-三天及以上"},{"columnName":"businesstrip_xian_lessthanthreedays","columnType":"int4","length":10,"comment":"出差-西安-少于三天"},{"columnName":"businesstrip_luoyang_instate","columnType":"int4","length":10,"comment":"出差-洛阳-驻在"},{"columnName":"businesstrip_nonlocal","columnType":"int4","length":10,"comment":"出差-外地"},{"columnName":"vacation_xian_abovethreedays","columnType":"int4","length":10,"comment":"休假-西安-三天及以上"},{"columnName":"vacation_xian_lessthanthreedays","columnType":"int4","length":10,"comment":"休假-西安-少于三天"},{"columnName":"vacation_nonlocal","columnType":"int4","length":10,"comment":"休假-外地"},{"columnName":"study_xian","columnType":"int4","length":10,"comment":"学习-西安"},{"columnName":"study_nonlocal","columnType":"int4","length":10,"comment":"学习-外地"},{"columnName":"go_abroad","columnType":"varchar","length":4000,"comment":"出国"},{"columnName":"recuperate","columnType":"varchar","length":4000,"comment":"疗养"},{"columnName":"departure_date","columnType":"timestamp","length":29,"comment":"出差日期"},{"columnId":"end_date","columnName":"end_date","columnType":"timestamp","length":29,"comment":"预计返程时间"},{"columnName":"address_area_name","columnType":"varchar","length":4000,"comment":"外出地址"},{"columnName":"remarks","columnType":"varchar","length":4000,"comment":"备注"},{"columnName":"test","columnType":"int4","length":10,"comment":"测试"},{"columnName":"attention","columnType":"varchar","length":4000,"comment":"需确认情况"}]}}';
        }

    }

    server {
        listen       59972;
        server_name  localhost;

        location / {
            root   html_jiafengGame;
            index  index.html index.htm;
        }
    }

    server {
        listen       59973;
        server_name  localhost;

        location / {
            root   html_minigame;
            index  index.html index.htm;
        }

        # API 代理 (规避跨域问题)
        location /api {
            proxy_pass http://localhost:3001;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
        }
    }

    server {
        listen       59974;
        server_name  localhost;

        location / {
            root   html_project\html;
            index  index.html index.htm;
        }

        # API 代理 (规避跨域问题)
        location /api {
            proxy_pass http://127.0.0.1:5500;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
        }
        # Socket.IO 代理
        location /socket.io {
            proxy_pass http://127.0.0.1:5500;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
        }
    }

    server {
        listen       59977;
        server_name  localhost;

        location / {
            root   html_update;
            index  index.html index.htm;
        }

        # 添加login转发
        location /v1/3rd/api {
            proxy_pass http://localhost:5000;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
        location /wps-api/ {
            # 将 /wps-api/ 前缀去掉后转发
            proxy_pass https://openapi.wps.cn/;

            # 必要的代理头
            proxy_set_header Host openapi.wps.cn;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_ssl_server_name on;  # SNI 支持（HTTPS 必需）

            # 超时设置
            proxy_connect_timeout 10s;
            proxy_read_timeout 30s;
         }

    }

    server {
        listen       81;
        server_name  localhost;

        #charset koi8-r;

        # access_log  logs/host.access.log  main;

        # access_log /var/log/nginx/custom.log custom;

        location / {
