        location /res/font1.ttf {
            proxy_pass https://cdn.yofijoy.com/res/font1.ttf;
            proxy_set_header Host cdn.yofijoy.com;
            proxy_redirect off;  # 禁止 302 跳转
        }

        # 添加 sdk.gateway.yofijoy.com 的代理配置，修改 Origin 和 Referer
        location /moli/ {
            # 代理到目标服务器
            proxy_pass http://117.72.146.66:89/;
            
            # 修改请求头
            # proxy_set_header Host sdk.gateway.yofijoy.com;
            # proxy_set_header Origin "http://mlcdn.quannijoy.com";
            # proxy_set_header Referer "http://mlcdn.quannijoy.com/";
            # proxy_set_header Yofichannelid "4";
            # proxy_set_header Yofideviceid "";
            # proxy_set_header Yofipackagename "com.yofijoy.mlbbgl.h5";
            # proxy_set_header Yofisdkversion "1.0.0";
            # proxy_set_header Yofisystem "5";
            # proxy_set_header Yofiversion "1.0.0";
            # proxy_set_header Clientid "10004";
            
            # 其他常用头设置
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            
            # 禁止重定向
            proxy_redirect off;
            
            # 允许跨域（如果需要）
            add_header Access-Control-Allow-Origin *;
            add_header Access-Control-Allow-Methods 'GET, POST, OPTIONS';
            add_header Access-Control-Allow-Headers 'DNT,X-Mx-ReqToken,Keep-Alive,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Authorization';
            
            # 处理 OPTIONS 预检请求
            if ($request_method = 'OPTIONS') {
                return 204;
            }
        }

        location /servers.json {
            proxy_pass http://localhost:59977;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }


        error_page   500 502 503 504  /50x.html;
        location = /50x.html {
            root   html;
        }
    }

}