            proxy_pass http://mlrg.u2ip.com:5099/res/audio;
            # proxy_set_header Referer "https://mlrg.u2ip.com:5099/libs/laya/min/workerloader.min.js";
            proxy_set_header Host mlrg.u2ip.com:5099;
