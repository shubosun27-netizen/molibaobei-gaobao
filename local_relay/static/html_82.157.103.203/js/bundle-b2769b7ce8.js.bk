        Nl.Singleton.reqCreateTeam(
          this.activityId,
          i,
          s,
          e,
          +this.fightInput.text,
          +this.passInput.text,
          mT.formatChatMsgBefore(this.customInput.text)
        ).then(() => {
          Xo.closeWindow(Bk);
        });
      }
    }
