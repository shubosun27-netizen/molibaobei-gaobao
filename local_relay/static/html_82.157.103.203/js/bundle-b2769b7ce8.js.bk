        let t = 1e3 * i.getTime() + 1e3;
        this.refreshTime = 0.001 * (t - a + 3600 * e.refresh_time[0] * 1e3);
      }
      this.timeSp.setText(
        Vr.formatDate(this.refreshTime),
        0,
        0,
        "18px Arial",
        "#ffff00",
        "left"
      ),
        Laya.timer.clearAll(this),
        Laya.timer.loop(1e3, this, this.onRefreshTime);
    }
    onRefreshTime() {
