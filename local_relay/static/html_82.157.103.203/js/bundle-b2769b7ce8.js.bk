    bindBtns() {
      $L.bindBtns([
        [
          this.rankBtn,
          [oa.FIRST_RED_POINT],
          $L.mainMenuRankBtnRedPoint,
          null,
          new Laya.Point(0, 0),
          !1,
        ],
      ]),
