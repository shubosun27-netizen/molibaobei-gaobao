    updateTotalFight() {
      this.combatTextSp.setText(
        pa.getInfoByLangID(187).format(Bl.userInfo.getCombat()),
        0,
        0,
        "16px Arial",
        "#FFDC80"
      );
    }
    onClickOpenMiniMap() {
      Bl.isArena
        ? zr.AddTipSimple(pa.getInfoByLangID(3032))
        : nc.Singleton.isOpen(C.OUTDOOR_BTN) && Xo.showWindow(mh);
    }
    updateMapName() {
      this.mapNameLb.text = ry.Singleton.getMapName();
    }
    onRenderHandler(e, t) {
      if (!e) return;
      let i = this.functionBtnList.getChildAt(0);
      i && (i.mouseThrough = !0);
      let s = this.functionBtnList.array[t];
      if (!s) return (e.visible = !1), void (e.mouseEnabled = !1);
      let n = s.iconId;
      (e.skin = ho.getTopFunctionIcon(n)),
        (e.visible = !0),
        (e.mouseEnabled = !0),
        e.clickHandler && (e.clickHandler.recover(), (e.clickHandler = void 0)),
        (e.clickHandler = Laya.Handler.create(
          this,
          this.onClickBtnCallBack,
          [s.functionId],
          !1
        )),
        yI.setRedpoint(e, this.checkTopRedpoint(s.functionId), 0, 8);
    }
    onOpenClick() {
      (this.isShowActivity = !this.isShowActivity),
        (this.boxActivity.visible = !this.boxActivity.visible && !Bl.isArena),
        this.isLandSceneFlag
          ? (this.openBtn.skin = this.isShowActivity
              ? "atlas/ui/main/btn_main_open_icon_hide_land.png"
              : "atlas/ui/main/btn_main_open_icon_show_land.png")
          : (this.openBtn.skin = this.isShowActivity
              ? "atlas/ui/main/btn_main_open_icon_hide.png"
              : "atlas/ui/main/btn_main_open_icon_show.png");
    }
    onClickPreview() {
      Fh.Singleton.checkLimitActivityShow(pb.ActivityType.HDYG, !0)
        ? Xo.showWindow(lv)
        : zr.AddTipSimple(pa.getInfoByLangID(Gw.STR_100078));
    }
    showMailView() {
      Bl.isArena
        ? zr.AddTipSimple(pa.getInfoByLangID(3032))
        : nc.Singleton.isOpen(C.MAIL) &&
