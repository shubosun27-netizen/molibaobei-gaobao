    (oa.GAMECIRCLE_REFRESH_POINT = "GAMECIRCLE_REFRESH_POINT");
  class ha extends Laya.EventDispatcher {
    constructor() {
      super(), (this.concurrent = 2);
    }
    loopHandler() {
      if (this.eventList.length < 1) return;
      let e;
      for (let t = 0; t < this.concurrent; t++)
        this.eventList.length > 0 &&
          ((e = this.eventList.shift()), super.event(e[0], e[1]));
    }
    on(e, t, i, s) {
      return super.on(e + "", t, i, s);
