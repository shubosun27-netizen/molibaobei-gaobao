      }
      if (this.teamInfo)
        Nl.Singleton.reqSetTeamInfo(
          this.activityId,
          i,
          s,
          e,
          this.fightInput.text,
          this.passInput.text,
          mT.formatChatMsgBefore(this.customInput.text)
        ).then(() => {
          Xo.closeWindow(Bk);
        });
      else {
        if (al.Singleton.hadSnailTask())
