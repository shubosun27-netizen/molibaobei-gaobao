    onInit() {
      (this.vipPos = this.vipBtn.localToGlobal(
        new Laya.Point(0.5 * this.vipBtn.width, 0.5 * this.vipBtn.height),
        !0
      )),
        (this.mouseThrough = !0),
        (this.boxActivity.visible = !1),
        (this.nameTxt.visible = !1),
        (this.lvNameLb.visible = !1),
        (this.combatTextSp.visible = !1),
        (this.mapNameLb.visible = !1),
        (this.mapNameLb.stroke = 3),
        (this.mapNameLb.strokeColor = "#211d1d"),
        (this.vipBtn.visible = !jh.Singleton.isIosWXShenHe()),
        (this.functionBtnList.visible = !1),
        this.onListener();
        this.vipBtn.label = "";
        this.vipBtn.label = null;
        this.vipBtn.labelStroke = 0;


        this.vipBtn.skin = "atlas/ui/topview/btn_topview_functionid_3100_cn.png";
        this.cardBtn.skin = "atlas/ui/topview/btn_topview_functionid_5400_cn.png";
        this.achieveBtn.skin = "atlas/ui/topview/btn_topview_functionid_6700_cn.png";

        // 主界面图标
        this.vipBtn.x = 105;   // 相对于父容器的 X 偏移
        this.vipBtn.y = 65;    // 相对于父容器的 Y 偏移
        this.cardBtn.x = 180;
        this.cardBtn.y = 65;
        this.achieveBtn.x = 255;
        this.achieveBtn.y = 65;
        this.vipBtn.width = 68;
        this.vipBtn.height = 36;
        this.cardBtn.width = 68;
        this.cardBtn.height = 36;
        this.achieveBtn.width = 68;
        this.achieveBtn.height = 36;
        // 清除并隐藏文字
        this.vipBtn.label = "";
        this.vipBtn.labelStroke = 0;
        this.cardBtn.label = "";
        this.achieveBtn.label = "";
        // 设置头像框的位置（相对于父容器）
          // 动态创建服务器时间文本（放在右上角示例）
        // this.nameTxt.x = 1000;   // 相对于父容器的 X 偏移
        // this.nameTxt.y = 15;    // 相对于父容器的 Y 偏移
        // this.lvNameLb.x = 255;   // 相对于父容器的 X 偏移
        // this.lvNameLb.y = 23;  
        // this.combatTextSp.x = 110;   // 相对于父容器的 X 偏移
        // this.combatTextSp.y = 45;
    }
    onShow() {
      (this.isShowActivity = !0),
        (this.isLandSceneFlag = o.getLandFlag()),
        this.onStageResize(),
        this.headIconImg.on(Laya.Event.CLICK, this, this.onChangeName),
        this.mapName.on(Laya.Event.CLICK, this, this.onClickOpenMiniMap),
        (this.mailBtn.clickHandler = Laya.Handler.create(
          this,
          this.showMailView,
          null,
          !1
        )),
        (this.rankBtn.clickHandler = Laya.Handler.create(
          this,
          this.onClickRank,
          null,
          !1
        )),
        (this.achieveBtn.clickHandler = Laya.Handler.create(
          this,
          this.onClicAchievement,
          null,
          !1
        )),
        (this.systemBtn.clickHandler = Laya.Handler.create(
          this,
          this.onClickHeadSet,
          null,
          !1
        )),
        (this.cardBtn.clickHandler = Laya.Handler.create(
          this,
          this.onBuffClick,
          null,
          !1
        )),
        (this.vipBtn.clickHandler = Laya.Handler.create(
          this,
          this.onVipClick,
          null,
          !1
        )),
        (this.openBtn.clickHandler = Laya.Handler.create(
          this,
          this.onOpenClick,
          null,
          !1
        )),
        (this.functionBtnList.mouseThrough = !0),
        (this.functionBtnList.hScrollBarSkin = ""),
        (this.functionBtnList.renderHandler = Laya.Handler.create(
          this,
          this.onRenderHandler,
          null,
          !1
        )),
        jl.waitLoad().then(() => {
          this.bindBtns(), this.onUpdateLanguage(), this.onMapChange();
        }),
        ca.on(oa.LANGUAGE_UPDATE_SET, this, this.onUpdateLanguage),
        ca.on(oa.HERO_LEVEL_CHANGE_AFTER, this, this.updateUserLevelChange);
    }
    onHide() {
      this._viewCreated &&
        (this.cleanFunctionBtnList(),
        this.mailBtn.clickHandler && this.mailBtn.clickHandler.recover(),
        (this.mailBtn.clickHandler = void 0),
        this.rankBtn.clickHandler && this.rankBtn.clickHandler.recover(),
        (this.rankBtn.clickHandler = void 0),
        this.achieveBtn.clickHandler && this.achieveBtn.clickHandler.recover(),
        (this.achieveBtn.clickHandler = void 0),
        this.systemBtn.clickHandler && this.systemBtn.clickHandler.recover(),
        (this.systemBtn.clickHandler = void 0),
        this.cardBtn.clickHandler && this.cardBtn.clickHandler.recover(),
        (this.cardBtn.clickHandler = void 0),
        this.vipBtn.clickHandler && this.vipBtn.clickHandler.recover(),
        (this.vipBtn.clickHandler = void 0),
        this.openBtn.clickHandler && this.openBtn.clickHandler.recover(),
        (this.openBtn.clickHandler = void 0),
        this.functionBtnList.renderHandler &&
          this.functionBtnList.renderHandler.recover(),
        (this.functionBtnList.renderHandler = void 0),
        this.headIconImg.off(Laya.Event.CLICK, this, this.onChangeName),
        this.mapName.off(Laya.Event.CLICK, this, this.onClickOpenMiniMap),
        ca.offAllCaller(this));
    }
    onDestroy() {
      super.onDestroy();
    }
    setGameScene(e) {
      this.gameScene = e;
    }
    onStageResize() {
      this.isLandSceneFlag
        ? ((this.width = Laya.stage.width - o.getLeftOffset()),
          (this.openBtn.skin =
            "atlas/ui/main/btn_main_open_icon_hide_land.png"),
          (this.functionBtnList.repeatY = 2))
        : ((this.width = Laya.stage.width),
          (this.openBtn.skin = "atlas/ui/main/btn_main_open_icon_hide.png")),
        (this.autoPilotSp.x = 0.5 * this.width),
        this.isLandSceneFlag ||
          (l.data.MINI_GAME_PLATFORM > 0
            ? (this.iconBox.height = 295)
            : (this.iconBox.height = 230));
    }
