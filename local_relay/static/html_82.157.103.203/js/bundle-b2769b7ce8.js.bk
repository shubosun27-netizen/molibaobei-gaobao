    getElementList() {
      let e = [],
        t = [
          pb.Property.LAND,
          pb.Property.WATER,
          pb.Property.FIRE,
          pb.Property.WIND,
        ];
      for (let i = 0; i < t.length; i++) {
        let s = this.totalPropDict.getN(t[i]);
        s && e.push([t[i], s]);
      }
      return e;
    }
  }
